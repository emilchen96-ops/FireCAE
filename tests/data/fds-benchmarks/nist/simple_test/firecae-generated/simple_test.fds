&HEAD CHID='simple_test', TITLE='Simple demonstration case.' /
&MESH ID='MESH_1', IJK=36,24,24, XB=0,3.6,0,2.4,0,2.4 /
&TIME T_END=60 /
&REAC ID='PROPANE_REACTION', FUEL='PROPANE', SOOT_YIELD=0.01 /
&SURF ID='BURNER', HRRPUA=1000, COLOR='RED' /
&OBST ID='BURNER_BASE', XB=0,0.4,1,1.4,0,0.2 /
&VENT ID='BURNER_VENT', XB=0,0.4,1,1.4,0.2,0.2, SURF_ID='BURNER' /
&VENT ID='OPENING', XB=3.6,3.6,0.8,1.6,0,2, SURF_ID='OPEN' /
&BNDF QUANTITY='GAUGE HEAT FLUX' /
&SLCF PBY=1.2, QUANTITY='TEMPERATURE', VECTOR=.TRUE. /
&TAIL /
