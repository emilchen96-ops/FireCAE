&HEAD CHID='HVAC_aircoil', TITLE='Test of aircoil' /
&MESH IJK=10,10,10, XB=0.,1.,0.,1.,0.,1. /
&MISC STRATIFICATION=F /
&RADI RADIATION=F /
&DUMP NFRAMES=20 /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&SURF ID='NULL' /
&SPEC ID='SPECIES1', MW=28, SPECIFIC_HEAT=1., BACKGROUND=T /
&VENT ID='INLET', XB=0.3,0.7,0.3,0.7,0.0,0.0, SURF_ID='HVAC', COLOR='RED' /
&VENT ID='OUTLET', XB=0.3,0.7,0.3,0.7,1.0,1.0, SURF_ID='HVAC', COLOR='GREEN' /
&HVAC ID='INLET', TYPE_ID='NODE', VENT_ID='INLET', DUCT_ID='DUCT' /
&HVAC ID='OUTLET', TYPE_ID='NODE', VENT_ID='OUTLET', DUCT_ID='DUCT' /
&HVAC ID='DUCT', TYPE_ID='DUCT', NODE_ID='INLET','OUTLET', LENGTH=1, AREA=0.1, VOLUME_FLOW=1.0, AIRCOIL_ID='AIRCOIL', TAU_VF=0. /
&HVAC ID='AIRCOIL', TYPE_ID='AIRCOIL', EFFICIENCY=0.5, COOLANT_SPECIFIC_HEAT=4.0, COOLANT_TEMPERATURE=100.0, COOLANT_MASS_FLOW=10.0 /
&DEVC ID='FDS Q', QUANTITY='AIRCOIL HEAT EXCHANGE', DUCT_ID='DUCT' /
&DEVC ID='FDS T', QUANTITY='NODE TEMPERATURE', NODE_ID='OUTLET' /
&OBST XB=0,1,0,1,0.4,0.6 /
&SLCF PBY=0.5, QUANTITY='TEMPERATURE', VECTOR=T /
&TIME T_END=1 /
&TAIL /
